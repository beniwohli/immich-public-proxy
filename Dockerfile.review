# The builder runs on the build host's own architecture whatever the target.
# Every production dependency is pure JavaScript and the native tooling
# (esbuild, rolldown, lightningcss) is dev-only, so the install and compile
# never need emulation; only the small runner stage below is built per target.
FROM --platform=$BUILDPLATFORM node:lts-alpine AS builder

# /ipp must be node-owned for npm ci; WORKDIR leaves it root-owned on some builders
RUN mkdir /ipp && chown node:node /ipp

USER node
WORKDIR /ipp

# npm ci needs the manifest of every workspace in the root `workspaces` array
COPY --chown=node:node package.json package-lock.json ./
COPY --chown=node:node shared/package.json shared/
COPY --chown=node:node app/package.json app/
COPY --chown=node:node upload-app/package.json upload-app/
COPY --chown=node:node suggestions/package.json suggestions/
COPY --chown=node:node review-app/package.json review-app/
RUN npm ci --workspace=review-app

COPY --chown=node:node shared/ shared/
COPY --chown=node:node suggestions/ suggestions/
COPY --chown=node:node review-app/ review-app/
RUN npm run build --workspace=shared --workspace=suggestions --workspace=review-app

# Production tree with @ipp/core and @ipp/suggestions dereferenced from their
# workspace symlinks into real folders (cp -L), so the runner's /app is self-contained. The apps'
# workspace links go first: the runner has the review service at /app, and
# IPP and the upload service have no place in this image.
RUN rm -rf node_modules \
    && npm ci --workspace=review-app --omit=dev \
    && rm -rf node_modules/immich-public-proxy node_modules/immich-public-proxy-upload node_modules/immich-public-proxy-review node_modules/.bin/immich-public-proxy* \
    && cp -rL node_modules /ipp/prod_modules \
    && cd /ipp/prod_modules/@ipp/core \
    && rm -rf src tests tsconfig.json vitest.config.ts dist/tsconfig.tsbuildinfo \
    && cd /ipp/prod_modules/@ipp/suggestions \
    && rm -rf src tests tsconfig.json vitest.config.ts dist/tsconfig.tsbuildinfo \
    && rm -f /ipp/review-app/dist/tsconfig.tsbuildinfo

FROM node:lts-alpine AS runner

RUN apk --no-cache add curl tini

WORKDIR /app
COPY --from=builder --chown=root:root /ipp/review-app/package.json ./
COPY --from=builder --chown=root:root /ipp/prod_modules ./node_modules
COPY --from=builder --chown=root:root /ipp/review-app/dist ./dist
COPY --from=builder --chown=root:root /ipp/review-app/public ./public

# The code is root-owned and the app runs as node, so a compromised process
# cannot rewrite it. The only runtime write is the suggestions database, on
# the volume shared with IPP at /var/data. The explicit --chown is for
# buildah, which keeps the builder's owner on COPY --from.
USER node

ARG PACKAGE_VERSION
ENV APP_VERSION=${PACKAGE_VERSION}
ENV NODE_ENV=production

# tini as PID 1 reaps orphaned healthcheck processes, which node does not (GitHub #66).
# -s keeps reaping, without a warning, when PID 1 is already an init (compose `init: true`).
ENTRYPOINT ["/sbin/tini", "-s", "--"]
CMD ["node", "dist/index.js" ]
