{
  "name": "immich-public-proxy-workspace",
  "private": true,
  "workspaces": [
    "shared",
    "suggestions",
    "app",
    "upload-app",
    "review-app"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm test --workspaces && vitest run --root docs",
    "lint": "eslint shared suggestions app upload-app review-app --ext .ts,.tsx",
    "dev": "npm run dev --workspace=app",
    "bump": "npm version --no-git-tag-version --workspaces"
  }
}
