{
  "name": "immich-public-proxy-review",
  "version": "4.0.0",
  "private": true,
  "scripts": {
    "predev": "tsc -b ../shared",
    "dev": "concurrently -n core,server -c magenta,blue \"tsc -b -w --preserveWatchOutput ../shared\" \"tsx watch src/index.ts\"",
    "build": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/index.js"
  },
  "author": "Benjamin Wohlwend",
  "license": "AGPL-3.0",
  "description": "Lets the owner of an Immich Public Proxy review the names and dates visitors suggest, and apply them to Immich.",
  "repository": {
    "type": "git",
    "url": "https://github.com/beniwohli/immich-public-proxy.git"
  },
  "main": "dist/index.js",
  "dependencies": {
    "@ipp/core": "*",
    "@ipp/suggestions": "*",
    "cookie-session": "^2.1.0",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "openid-client": "^6.8.8",
    "preact": "^10.29.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/cookie-session": "^2.0.49",
    "@types/express": "^4.17.21",
    "@types/node": "^22",
    "@typescript-eslint/eslint-plugin": "^7",
    "@typescript-eslint/parser": "^7",
    "concurrently": "^10.0.3",
    "eslint": "^8.57.0",
    "eslint-config-standard": "^17.1.0",
    "tsx": "^4",
    "typescript": "^5.6.2",
    "vitest": "^4"
  }
}
